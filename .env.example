# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ==============================================================================
# QDRANT CLOUD CONFIGURATION
# ==============================================================================
# Qdrant Cloud URL (e.g., https://your-project-uuid.qdrant.io:6333)
# Get this from the Qdrant Cloud console
QDRANT_URL=

# Qdrant Cloud API Key
# Create this in the Qdrant Cloud API keys section
QDRANT_API_KEY=

# Collection name for IP-SAKTI knowledge base
QDRANT_COLLECTION=ipsakti_knowledge

# ==============================================================================
# LLAMA CLOUD CONFIGURATION
# ==============================================================================
# LlamaCloud API Key for document parsing and extraction
# Get this from https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=

# ==============================================================================
# EMBEDDING MODEL CONFIGURATION
# ==============================================================================
# OpenAI API Key for embeddings and LLM
OPENAI_API_KEY=

# Embedding model to use (text-embedding-3-small provides 1536 dimensions)
EMBEDDING_MODEL=text-embedding-3-small

# ==============================================================================
# RAG RETRIEVAL CONFIGURATION
# ==============================================================================
# Number of top results to retrieve for semantic search
RETRIEVAL_TOP_K=8

# Similarity score threshold (0-1). Documents below this are filtered out.
# Set to 0 to retrieve all results regardless of score
SIMILARITY_THRESHOLD=0.5

# ==============================================================================
# CHUNKING CONFIGURATION
# ==============================================================================
# Chunk size in characters (suggested: 512-1024 for legal docs)
CHUNK_SIZE=1024

# Overlap between chunks in characters (suggested: 128-256)
CHUNK_OVERLAP=256

# ==============================================================================
# LLM CONFIGURATION
# ==============================================================================
# LLM Provider (openai, anthropic, etc.)
LLM_PROVIDER=openai

# LLM Model name
LLM_MODEL=gpt-4o-mini

# LLM API Key (can be same as OPENAI_API_KEY if using OpenAI)
LLM_API_KEY=
